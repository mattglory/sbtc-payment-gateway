# =============================================================================
# 🚀 GREEN FINANCE PLATFORM - BITCOIN FRONTIER FUND DEMO
# =============================================================================
#
# FOR GRANT REVIEWERS:
# 1. Copy this file to .env.local
# 2. Set NEXT_PUBLIC_DEMO_MODE=true (see below)
# 3. Run: npm install && npm run dev
# 4. Platform works fully in demo mode without real API keys!
#
# SECURITY: Never commit .env.local to version control
#
# =============================================================================

# =============================================================================
# 🎯 DEMO MODE CONFIGURATION (Perfect for Grant Reviews!)
# =============================================================================

# Enable demo mode - Platform works 100% without real API keys
NEXT_PUBLIC_DEMO_MODE=true

# Demo environment settings
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# 🤖 AI SERVICES (Optional - Demo mode has realistic mock data)
# =============================================================================

# OpenAI API Configuration
# Get from: https://platform.openai.com/api-keys
# DEMO NOTE: Leave as placeholder - not needed in demo mode
OPENAI_API_KEY=demo-mode-no-key-needed
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# Anthropic Claude API Configuration
# Get from: https://console.anthropic.com/
# DEMO NOTE: Leave as placeholder - not needed in demo mode
ANTHROPIC_API_KEY=demo-mode-no-key-needed
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Vercel Edge Config (for feature flags and configuration)
EDGE_CONFIG=your-edge-config-connection-string-here
EDGE_CONFIG_ID=your-edge-config-id-here

# =============================================================================
# ESG DATA PROVIDERS
# =============================================================================

# MSCI ESG Data API
MSCI_API_KEY=your-msci-api-key-here
MSCI_API_BASE_URL=https://api.msci.com/esg/v1

# Refinitiv ESG Data
REFINITIV_API_KEY=your-refinitiv-api-key-here
REFINITIV_API_BASE_URL=https://api.refinitiv.com/data/esg/v1

# Sustainalytics API
SUSTAINALYTICS_API_KEY=your-sustainalytics-api-key-here
SUSTAINALYTICS_API_BASE_URL=https://api.sustainalytics.com/v1

# Financial Data APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here
FINNHUB_API_KEY=your-finnhub-api-key-here
POLYGON_API_KEY=your-polygon-api-key-here

# =============================================================================
# ₿ BLOCKCHAIN & PAYMENT CONFIGURATION
# =============================================================================

# Stacks Network Configuration (Testnet for demo safety)
NEXT_PUBLIC_STACKS_NETWORK=testnet
NEXT_PUBLIC_STACKS_API_URL=https://api.testnet.hiro.so
NEXT_PUBLIC_STACKS_EXPLORER_URL=https://explorer.stacks.co

# sBTC Configuration (Demo addresses)
NEXT_PUBLIC_sBTC_CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
NEXT_PUBLIC_sBTC_NETWORK=testnet

# SECURITY NOTE: Never put real private keys in config files
# Demo mode uses simulated wallet interactions

# =============================================================================
# CARBON OFFSET & ENVIRONMENTAL DATA
# =============================================================================

# Carbon Credit APIs
CARBON_CREDIT_API_KEY=your-carbon-credit-api-key-here
CARBON_CREDIT_API_BASE_URL=https://api.carboncredits.com/v1

# Climate Data APIs
CLIMATE_DATA_API_KEY=your-climate-data-api-key-here
ENVIRONMENTAL_API_KEY=your-environmental-api-key-here

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/green_finance_db
DATABASE_URL_NONPROD=postgresql://username:password@localhost:5432/green_finance_dev

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password-here

# Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-here
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_COOKIE_NAME=green-finance-session

# API Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Encryption Keys
ENCRYPTION_KEY=your-32-character-encryption-key-here
HASH_SALT=your-hash-salt-here

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourapp.com

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=GA-your-google-analytics-id
SENTRY_DSN=your-sentry-dsn-here
MIXPANEL_TOKEN=your-mixpanel-token-here

# Social Media APIs (for news feeds)
TWITTER_API_KEY=your-twitter-api-key-here
TWITTER_API_SECRET=your-twitter-api-secret-here
REDDIT_CLIENT_ID=your-reddit-client-id-here
REDDIT_CLIENT_SECRET=your-reddit-client-secret-here

# =============================================================================
# DEVELOPMENT & DEPLOYMENT
# =============================================================================

# Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0

# Base URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_BLOCKCHAIN=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ESG_NEWS=true

# Debug Configuration
DEBUG=green-finance:*
LOG_LEVEL=info

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# These will be set differently in production
# NEXT_PUBLIC_API_BASE_URL=https://your-production-domain.com/api
# NEXT_PUBLIC_APP_BASE_URL=https://your-production-domain.com
# NODE_ENV=production
# NEXT_PUBLIC_APP_ENV=production
# LOG_LEVEL=warn

# =============================================================================
# VERCEL SPECIFIC
# =============================================================================

# Vercel automatically provides these in production:
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app
# VERCEL_REGION=iad1

# Custom Vercel Configuration
VERCEL_TEAM_ID=your-vercel-team-id-here
VERCEL_PROJECT_ID=your-vercel-project-id-here